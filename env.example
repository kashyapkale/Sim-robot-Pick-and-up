# AWS Bedrock Configuration for Inference Profiles
# Option 1: Bearer Token (Recommended for inference profiles)
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here

# Option 2: AWS Credentials (Alternative)
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

AWS_REGION=us-east-1

# Optional: Customize the Bedrock model (using inference profile ARN)
# Llama 3.1 70B Instruct for text processing
LLAMA_MODEL_ID=arn:aws:bedrock:us-east-1:343218181127:inference-profile/us.meta.llama3-1-70b-instruct-v1:0 